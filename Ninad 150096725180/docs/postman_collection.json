{
  "info": {
    "name": "Library Management API",
    "_postman_id": "c1f7a29a-2512-4c6e-82d1-0f73f8a4e101",
    "description": "Postman collection for testing the complete Library Management REST API (Assignment 6)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "librarianToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testBookId",
      "value": "book_1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Student\",\n  \"email\": \"bob.student@library.com\",\n  \"password\": \"Student@123\",\n  \"role\": \"student\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Register Librarian",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Assistant Librarian\",\n  \"email\": \"assistant@library.com\",\n  \"password\": \"Librarian@123\",\n  \"role\": \"librarian\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login as Librarian",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('librarianToken', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@library.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login as Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('studentToken', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@library.com\",\n  \"password\": \"Student@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Profile (Authenticated)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/profile", "host": ["{{baseUrl}}"], "path": ["api", "auth", "profile"] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Updated Name\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/profile", "host": ["{{baseUrl}}"], "path": ["api", "auth", "profile"] }
          }
        }
      ]
    },
    {
      "name": "2. Books",
      "item": [
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/books", "host": ["{{baseUrl}}"], "path": ["api", "books"] }
          }
        },
        {
          "name": "Get Books Filtered by Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/books?category=Technology",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [{ "key": "category", "value": "Technology" }]
            }
          }
        },
        {
          "name": "Search Books by Keyword",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/books/search?q=Clean",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "search"],
              "query": [{ "key": "q", "value": "Clean" }]
            }
          }
        },
        {
          "name": "Get Single Book by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/books/{{testBookId}}", "host": ["{{baseUrl}}"], "path": ["api", "books", "{{testBookId}}"] }
          }
        },
        {
          "name": "Add New Book (Librarian Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{librarianToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Designing Data-Intensive Applications\",\n  \"author\": \"Martin Kleppmann\",\n  \"isbn\": \"978-1449373320\",\n  \"category\": \"System Design\",\n  \"quantity\": 4\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/books", "host": ["{{baseUrl}}"], "path": ["api", "books"] }
          }
        },
        {
          "name": "Update Book (Librarian Only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{librarianToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 6\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/books/{{testBookId}}", "host": ["{{baseUrl}}"], "path": ["api", "books", "{{testBookId}}"] }
          }
        },
        {
          "name": "Delete Book (Librarian Only)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{librarianToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/books/book_5", "host": ["{{baseUrl}}"], "path": ["api", "books", "book_5"] }
          }
        }
      ]
    },
    {
      "name": "3. Borrow & Return",
      "item": [
        {
          "name": "Borrow Book (Student Only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/books/{{testBookId}}/borrow", "host": ["{{baseUrl}}"], "path": ["api", "books", "{{testBookId}}", "borrow"] }
          }
        },
        {
          "name": "Return Book (Student Only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/books/{{testBookId}}/return", "host": ["{{baseUrl}}"], "path": ["api", "books", "{{testBookId}}", "return"] }
          }
        }
      ]
    },
    {
      "name": "4. Transactions",
      "item": [
        {
          "name": "Get My Transactions (Student)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/transactions/my", "host": ["{{baseUrl}}"], "path": ["api", "transactions", "my"] }
          }
        },
        {
          "name": "Get All Transactions (Librarian Only)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{librarianToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/transactions", "host": ["{{baseUrl}}"], "path": ["api", "transactions"] }
          }
        }
      ]
    },
    {
      "name": "5. User Management (Librarian)",
      "item": [
        {
          "name": "Get All Users (Librarian Only)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{librarianToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "Get User By ID (Librarian Only)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{librarianToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/user_student_1", "host": ["{{baseUrl}}"], "path": ["api", "users", "user_student_1"] }
          }
        },
        {
          "name": "Update User Role (Librarian Only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{librarianToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"librarian\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/user_student_1/role", "host": ["{{baseUrl}}"], "path": ["api", "users", "user_student_1", "role"] }
          }
        }
      ]
    }
  ]
}
